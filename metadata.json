{
  "name": "dodevops-ocsinventoryagent",
  "version": "1.0.0",
  "author": "Dennis Ploeger",
  "summary": "Installs the OCS Inventory agent for linux",
  "license": "MIT",
  "source": "https://github.com/dodevops/puppet-ocsinventoryagent",
  "project_page": "https://github.com/dodevops/puppet-ocsinventoryagent",
  "issues_url": "https://github.com/dodevops/puppet-ocsinventoryagent/issues",
  "dependencies": [
    {
      "name": "puppet-zypprepo",
      "version_requirement": ">= 2.2.2"
    }
  ],
  "operatingsystem_support": [
    {
